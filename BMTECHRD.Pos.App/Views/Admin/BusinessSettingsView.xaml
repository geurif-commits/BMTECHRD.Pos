<UserControl x:Class="BMTECHRD.Pos.App.Views.Admin.BusinessSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="8">
            <TextBlock Text="Personalización y fiscal" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="Configura nombre/logo del restaurante, ITBIS/propina y módulos fiscales RD." Foreground="#9CA3AF" Margin="0,0,0,14"/>

            <TextBlock Text="Nombre del restaurante"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,4,0,10"/>

            <CheckBox Content="Aplicar ITBIS" IsChecked="{Binding EnableItbis}" Margin="0,6,0,4"/>
            <TextBox Text="{Binding ItbisRate, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,10"/>

            <CheckBox Content="Aplicar propina legal" IsChecked="{Binding EnableTip}" Margin="0,6,0,4"/>
            <TextBox Text="{Binding TipRate, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,10"/>

            <Separator Margin="0,10,0,10"/>
            <CheckBox Content="Habilitar comprobante fiscal (NFC) - roadmap" IsChecked="{Binding EnableFiscalReceipt}" Margin="0,6,0,4"/>
            <CheckBox Content="Habilitar facturación electrónica (e-CF) - roadmap" IsChecked="{Binding EnableElectronicInvoice}" Margin="0,6,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Guardar" Width="140" Height="40" Click="OnSaveClick"/>
                <Button Content="Recargar" Width="140" Height="40" Margin="10,0,0,0" Click="OnReloadClick"/>
            </StackPanel>

            <TextBlock Text="{Binding InfoMessage}" Foreground="#34D399" Margin="0,10,0,0"/>
            <TextBlock Text="{Binding Error}" Foreground="#F87171" Margin="0,6,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
