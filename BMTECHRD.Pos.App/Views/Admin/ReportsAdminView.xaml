<UserControl x:Class="BMTECHRD.Pos.App.Views.Admin.ReportsAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:BMTECHRD.Pos.App.Models"
             xmlns:controls="clr-namespace:BMTECHRD.Pos.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="#FF121213">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header y Filtros -->
        <StackPanel Grid.Row="0" Background="#FF1E1F21">
            <StackPanel Margin="16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="Reportes - Ventas" FontSize="24" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Cargando..." Foreground="#AAA" Margin="12,4,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                
                <TextBlock Text="{Binding Error}" Foreground="#FF4444" FontSize="12" Visibility="{Binding ErrorVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12" />

                <!-- Filtros -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Desde -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Desde" Foreground="#DDD" FontSize="12" />
                        <DatePicker SelectedDate="{Binding FromDate}" Background="#FF2A2B2E" Foreground="White" Width="140" Height="40" Padding="8" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Hasta -->
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Hasta" Foreground="#DDD" FontSize="12" />
                        <DatePicker SelectedDate="{Binding ToDate}" Background="#FF2A2B2E" Foreground="White" Width="140" Height="40" Padding="8" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Botones Rápidos -->
                    <Button Grid.Column="2" Content="7 días" Width="90" Height="40" Margin="0,20,8,0" Command="{Binding SetRange7DaysCommand}" />
                    <Button Grid.Column="3" Content="Hoy" Width="90" Height="40" Margin="0,20,8,0" Command="{Binding SetRangeTodayCommand}" />
                    <Button Grid.Column="4" Content="Este mes" Width="90" Height="40" Margin="0,20,8,0" Command="{Binding SetRangeMonthCommand}" />

                    <!-- Refrescar -->
                    <Button Grid.Column="5" Content="Refrescar" Width="120" Height="40" Margin="0,20,0,0" Command="{Binding LoadReportsCommand}" />
                </Grid>
            </StackPanel>
        </StackPanel>

        <!-- KPIs -->
        <StackPanel Grid.Row="1" Background="#FF1E1F21" Margin="16">
            <TextBlock Text="Indicadores Clave" FontWeight="Bold" Foreground="White" FontSize="14" Margin="0,0,0,12" />
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total Ventas -->
                <Border Grid.Column="0" Background="#FF2A2B2E" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Total Ventas" Foreground="#AAA" FontSize="12" />
                        <TextBlock Text="{Binding TotalSales, StringFormat=C}" Foreground="#4CAF50" FontSize="20" FontWeight="Bold" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Promedio Diario -->
                <Border Grid.Column="1" Background="#FF2A2B2E" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Promedio Diario" Foreground="#AAA" FontSize="12" />
                        <TextBlock Text="{Binding AverageDaily, StringFormat=C}" Foreground="#4CAF50" FontSize="20" FontWeight="Bold" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Total Cobrado -->
                <Border Grid.Column="2" Background="#FF2A2B2E" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Total Cobrado" Foreground="#AAA" FontSize="12" />
                        <TextBlock Text="{Binding PaymentsTotal, StringFormat=C}" Foreground="#4CAF50" FontSize="20" FontWeight="Bold" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Desglose Pagos -->
                <Border Grid.Column="3" Background="#FF2A2B2E" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Métodos de Pago" Foreground="#AAA" FontSize="12" />
                        <StackPanel Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Efectivo: " Foreground="#DDD" Width="70" />
                                <TextBlock Text="{Binding PaymentsCash, StringFormat=C}" Foreground="#4CAF50" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="Tarjeta: " Foreground="#DDD" Width="70" />
                                <TextBlock Text="{Binding PaymentsCard, StringFormat=C}" Foreground="#4CAF50" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="Transfer: " Foreground="#DDD" Width="70" />
                                <TextBlock Text="{Binding PaymentsTransfer, StringFormat=C}" Foreground="#4CAF50" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="Mixto: " Foreground="#DDD" Width="70" />
                                <TextBlock Text="{Binding PaymentsMixed, StringFormat=C}" Foreground="#4CAF50" FontWeight="Bold" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- Gráfico y Listas -->
        <StackPanel Grid.Row="2" Margin="16">
            <Grid Height="350" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="400" />
                </Grid.ColumnDefinitions>

                <!-- Gráfico Diario -->
                <Border Grid.Column="0" Background="#FF1E1F21" CornerRadius="8" Margin="0,0,8,0">
                    <controls:ReportsLineChartControl ItemsSource="{Binding DailyReport.Items}" />
                </Border>

                <!-- Listas Derecha -->
                <StackPanel Grid.Column="1">
                    <!-- Top Productos -->
                    <Border Background="#FF1E1F21" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Top Productos" FontWeight="Bold" Foreground="White" Margin="0,0,0,8" />
                            <ListBox ItemsSource="{Binding TopProducts}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="150">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="models:SalesByProductModel">
                                        <Border Background="#FF2A2B2E" Padding="8" Margin="0,0,0,4" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="Bold" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Qty}" Foreground="#AAA" Width="30" />
                                                    <TextBlock Text="{Binding Total, StringFormat=C}" Foreground="#4CAF50" FontWeight="Bold" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Top Usuarios -->
                    <Border Background="#FF1E1F21" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Top Vendedores" FontWeight="Bold" Foreground="White" Margin="0,0,0,8" />
                            <ListBox ItemsSource="{Binding TopUsers}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="150">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="models:SalesByUserModel">
                                        <Border Background="#FF2A2B2E" Padding="8" Margin="0,0,0,4" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Username}" Foreground="White" FontSize="12" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Total, StringFormat=C}" Foreground="#4CAF50" FontWeight="Bold" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
