<UserControl x:Class="BMTECHRD.Pos.App.Views.CashierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BMTECHRD.Pos.App.ViewModels"
             xmlns:models="clr-namespace:BMTECHRD.Pos.App.Models">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Background="#FF121213" Padding="12">
        <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: open tables -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="Mesas abiertas" Foreground="White" FontSize="20" Margin="8" />
            <ListView ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable, Mode=TwoWay}" Margin="8" Background="#FF121213">
                <ListView.ItemTemplate>
                    <DataTemplate DataType="models:TableSummaryModel">
                        <Border Background="#FF1E1F21" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding TableNumber, StringFormat=Mesa {0}}" Foreground="White" FontSize="18" FontWeight="Bold" />
                                    <TextBlock Text="{Binding CurrentTotal, StringFormat=Total: {0:C}}" Foreground="#DDD" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Pendientes" Foreground="OrangeRed" Visibility="{Binding HasPendingItems, Converter={StaticResource BoolToVis}}" FontWeight="Bold" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!-- Right: bill and payments -->
        <StackPanel Grid.Column="1" Margin="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                <TextBlock Text="Caja" Foreground="White" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="{Binding LoadingText}" Foreground="#AAA" Margin="12,4,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,0,0">
                    <TextBlock Text="{Binding ShiftLabel}" Foreground="#DDD" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Abrir turno" Width="120" Height="32" Margin="4,0,0,0" Command="{Binding OpenShiftCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveShift}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Cerrar turno" Width="120" Height="32" Margin="4,0,0,0" Command="{Binding CloseShiftCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveShift}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Error banner -->
            <Border Background="#8B0000" CornerRadius="6" Padding="8" Margin="0,8,0,8" Visibility="{Binding ErrorVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Error}" Foreground="White" />
            </Border>

            <!-- Close blocked banner -->
            <Border Background="#FF8C00" CornerRadius="6" Padding="8" Margin="0,0,0,8" Visibility="{Binding CloseBlockedReason, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding CloseBlockedReason}" Foreground="White" />
            </Border>

            <!-- No active shift banner -->
            <Border Background="#444" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasActiveShift}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="Debe abrir turno para cobrar" Foreground="White" />
            </Border>

            <Border Background="#FF1E1F21" CornerRadius="8" Padding="12" MinHeight="260">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:BillLineModel">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Quantity}" Foreground="#DDD" Grid.Column="0" />
                                    <TextBlock Text="{Binding Name}" Foreground="White" Grid.Column="1" />
                                    <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:C}}" Foreground="#DDD" Grid.Column="2" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding LineTotal, StringFormat={}{0:C}}" Foreground="#FFF" Grid.Column="3" HorizontalAlignment="Right" />
                                    <!-- status badge -->
                                    <TextBlock Text="{Binding Status}" Foreground="#FFF" Background="#444" Padding="4" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,0" Visibility="Visible" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Subtotal" Foreground="#DDD" />
                            <TextBlock Text="{Binding Subtotal, StringFormat={}{0:C}}" Foreground="White" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Pagado" Foreground="#DDD" />
                            <TextBlock Text="{Binding Paid, StringFormat={}{0:C}}" Foreground="White" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Por pagar" Foreground="#DDD" />
                            <TextBlock Text="{Binding Due, StringFormat={}{0:C}}" Foreground="OrangeRed" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Payments -->
            <StackPanel Orientation="Vertical" Margin="0,12,0,0">
                <TextBlock Text="Pagos" Foreground="White" FontSize="18" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Efectivo" Width="120" Height="48" Margin="6" Command="{Binding SetPaymentMethodCommand}" CommandParameter="CASH" />
                    <Button Content="Tarjeta" Width="120" Height="48" Margin="6" Command="{Binding SetPaymentMethodCommand}" CommandParameter="CARD" />
                    <Button Content="Transfer" Width="120" Height="48" Margin="6" Command="{Binding SetPaymentMethodCommand}" CommandParameter="TRANSFER" />
                    <Button Content="Mixto" Width="120" Height="48" Margin="6" Command="{Binding SetPaymentMethodCommand}" CommandParameter="MIXED" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Center">
                    <TextBlock Text="Monto" Foreground="#DDD" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="160" Text="{Binding PaymentAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Entregado" Foreground="#DDD" VerticalAlignment="Center" Margin="12,0,8,0" />
                    <TextBox Width="120" Text="{Binding CashGiven, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Devuelta:" Foreground="#DDD" VerticalAlignment="Center" Margin="12,0,8,0" />
                    <TextBlock Text="{Binding Change, StringFormat={}{0:C}}" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button Content="Registrar pago" Width="220" Height="56" Command="{Binding RegisterPaymentCommand}" IsEnabled="{Binding SelectedTable, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Refrescar mesas" Width="140" Height="56" Margin="12,0,0,0" Command="{Binding RefreshTablesCommand}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
        </Grid>
    </Border>
</UserControl>