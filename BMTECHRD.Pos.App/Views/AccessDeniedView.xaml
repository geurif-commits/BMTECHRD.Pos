<UserControl x:Class="BMTECHRD.Pos.App.Views.AccessDeniedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Grid Background="#FF121213">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
            <TextBlock Text="Acceso Denegado" 
                       FontSize="32" 
                       FontWeight="Bold" 
                       Foreground="#FF4444" 
                       TextAlignment="Center" 
                       Margin="0,0,0,24" />
            
            <TextBlock Text="Este usuario no tiene permisos para el modo del dispositivo." 
                       FontSize="16" 
                       Foreground="#DDD" 
                       TextAlignment="Center" 
                       Margin="0,0,0,32" 
                       MaxWidth="400" 
                       TextWrapping="Wrap" />
            
            <Button Content="Cerrar sesión" 
                    Width="200" 
                    Height="56" 
                    FontSize="16" 
                    Click="OnLogoutClick"
                    HorizontalAlignment="Center"
                    Background="#FF2A2B2E"
                    Foreground="White"
                    Cursor="Hand" />
        </StackPanel>
    </Grid>
</UserControl>
