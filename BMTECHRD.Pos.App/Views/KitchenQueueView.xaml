<UserControl x:Class="BMTECHRD.Pos.App.Views.KitchenQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BMTECHRD.Pos.App.ViewModels"
             xmlns:models="clr-namespace:BMTECHRD.Pos.App.Models"
             Height="Auto" Width="Auto">
    <Border Background="#FF121213" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                <TextBlock Text="COCINA" Foreground="White" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,0,0">
                    <Button Content="Refrescar" x:Name="BtnRefresh" Width="140" Height="44" Margin="12,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Filter -->
            <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Left" Margin="0,0,0,12">
                <Button Content="Pendientes" x:Name="BtnPending" Width="140" Height="40" Margin="0,0,8,0"/>
                <Button Content="En proceso" x:Name="BtnInProgress" Width="140" Height="40" Margin="0,0,8,0"/>
                <Button Content="Todos" x:Name="BtnAll" Width="140" Height="40" />
            </StackPanel>

            <!-- List -->
            <ScrollViewer Grid.Row="2">
                <ListView x:Name="ItemsListView" ItemsSource="{Binding Items}">
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="models:ProductionQueueItemModel">
                            <Border Background="#FF1E1F21" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Mesa" Foreground="#AAA" FontSize="12" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding TableNumber}" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding ProductName}" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock Text="Cantidad: {Binding Quantity}" Foreground="#CCC" FontSize="16"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TimeLabel}" Foreground="#AAA" HorizontalAlignment="Right"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                            <Button Content="En proceso" x:Name="BtnStart" Width="90" Height="36" Margin="0,0,8,0"/>
                                            <Button Content="Listo" x:Name="BtnDone" Width="90" Height="36"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>