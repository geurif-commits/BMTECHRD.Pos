<UserControl x:Class="BMTECHRD.Pos.App.Views.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#FF121213">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Width="520"
                Padding="24"
                CornerRadius="16"
                Background="#FF1E1F21"
                BorderBrush="#FF2A2B2E"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>

                <TextBlock Text="BMTECHRD POS"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />

                <TextBlock Text="Inicia sesión"
                           Foreground="#FFB8B8B8"
                           FontSize="14"
                           Margin="0,0,0,18" />

                <TextBlock Text="Business ID"
                           Foreground="#FFD6D6D6"
                           Margin="0,0,0,6"/>
                <TextBox Height="40"
                         Text="{Binding BusinessIdText, UpdateSourceTrigger=PropertyChanged}"
                         Background="#FF121213"
                         Foreground="White"
                         BorderBrush="#FF2A2B2E"
                         Padding="10,6"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Usuario"
                           Foreground="#FFD6D6D6"
                           Margin="0,0,0,6"/>
                <TextBox Height="40"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Background="#FF121213"
                         Foreground="White"
                         BorderBrush="#FF2A2B2E"
                         Padding="10,6"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Contraseña"
                           Foreground="#FFD6D6D6"
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="Pwd"
                             Height="40"
                             Background="#FF121213"
                             Foreground="White"
                             BorderBrush="#FF2A2B2E"
                             Padding="10,6"
                             Margin="0,0,0,12"
                             PasswordChanged="OnPasswordChanged"/>

                <TextBlock Text="{Binding DeviceIdHint}"
                           Foreground="#FF8D8D8D"
                           FontSize="12"
                           Margin="0,0,0,16" />

                <Button Content="{Binding LoginButtonText}"
                        Height="44"
                        Background="#FF2A2B2E"
                        Foreground="White"
                        BorderBrush="#FF3A3B3E"
                        BorderThickness="1"
                        FontWeight="SemiBold"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding CanLogin}"
                        />

                <TextBlock Text="{Binding Error}"
                           Foreground="#FFFF6B6B"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"/>

                <TextBlock Text="{Binding Status}"
                           Foreground="#FFB8B8B8"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>