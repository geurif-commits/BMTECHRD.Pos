<UserControl x:Class="BMTECHRD.Pos.App.Controls.DraggableTableControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BMTECHRD.Pos.App.Controls"
             Width="120" Height="80">
    <Grid>
        <Border x:Name="RootBorder" CornerRadius="8" Padding="8" Background="#FF2D2F31" BorderBrush="#FF444444" BorderThickness="1">
            <Grid>
                <TextBlock Text="{Binding Number}" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border x:Name="Badge" Background="#FF4CAF50" CornerRadius="6" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="6" Margin="0,-10,-10,0" Visibility="Collapsed">
                    <TextBlock Text="{Binding WaiterName}" Foreground="White" FontSize="12"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>