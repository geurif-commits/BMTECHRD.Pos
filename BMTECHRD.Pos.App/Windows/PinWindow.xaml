<Window x:Class="BMTECHRD.Pos.App.Windows.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter PIN" Height="220" Width="320" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Border Background="#FF2A2A2D" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Enter 4-digit PIN" Foreground="White" FontSize="18" HorizontalAlignment="Center"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBox x:Name="Box0" Width="48" Height="64" FontSize="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLength="1" Margin="4,0"/>
                <TextBox x:Name="Box1" Width="48" Height="64" FontSize="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLength="1" Margin="4,0"/>
                <TextBox x:Name="Box2" Width="48" Height="64" FontSize="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLength="1" Margin="4,0"/>
                <TextBox x:Name="Box3" Width="48" Height="64" FontSize="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLength="1" Margin="4,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button x:Name="BtnCancel" Content="Cancel" Width="120" Height="44" Margin="6,0"/>
                <Button x:Name="BtnOk" Content="OK" Width="120" Height="44" Margin="6,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>